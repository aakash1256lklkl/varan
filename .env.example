# =========================================================
#  VARAN — AI Provider Configuration
#  Copy this file to `.env` and set your provider + key.
# =========================================================

# Which provider to use.
#   openai        - OpenAI (paid key in AI_API_KEY)
#   openrouter    - Many models, one key (https://openrouter.ai)
#   groq          - Fast free tier (https://console.groq.com)
#   mistral       - Mistral models
#   ollama        - LOCAL, free, no key (run `ollama serve`)
#   lmstudio      - LOCAL LM Studio server
#   anthropic     - Anthropic Claude (native)
#   gemini        - Google Gemini (native)
AI_PROVIDER=ollama

# Base URL. Leave blank to use the preset for your provider.
# AI_BASE_URL=

# Model name.
AI_MODEL=llama3.2

# API key (leave blank for local providers like ollama/lmstudio)
# AI_API_KEY=
